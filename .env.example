# Copy to .env and edit. Real env vars override values here.

# ---------------------------------------------------------------------------
# OVHcloud credentials
# ---------------------------------------------------------------------------
# ovh-eu, ovh-ca, ovh-us, soyoustart-eu, soyoustart-ca, kimsufi-eu, kimsufi-ca
OVH_ENDPOINT=ovh-eu

# Preferred: an OAuth2 service account, created at
# https://www.ovh.com/manager/#/dedicated/useraccount/api-credentials
# (ovh-eu, ovh-ca and ovh-us only). It needs GET/POST/DELETE on /telephony/*.
OVH_CLIENT_ID=
OVH_CLIENT_SECRET=

# Or the older application key / secret / consumer key triplet, from
# https://eu.api.ovh.com/createToken/ — used only when the OAuth2 pair is empty.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# ---------------------------------------------------------------------------
# What to show
# ---------------------------------------------------------------------------
# Comma-separated. Empty means every line the credentials can see — which also
# saves one API call per listing.
BILLING_ACCOUNTS=
VOICEMAILS=

# Format asked of the API: mp3, ogg, wav, aiff, au or flac.
AUDIO_FORMAT=mp3

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Basic auth in front of the whole app. Leave AUTH_USER empty to disable it —
# but remember this app reads and deletes voicemails.
AUTH_USER=
AUTH_PASSWORD=

# Server-side caches (seconds). Recordings never change, so they are kept for
# a month; the line list and message lists are only cached to keep clicking
# around from hitting the API every time.
LINES_TTL=300
MESSAGES_TTL=30
AUDIO_TTL=2592000

# How long to wait for OVHcloud to prepare a recording or a transcript.
FILE_WAIT=25
