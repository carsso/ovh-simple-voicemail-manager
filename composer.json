{
    "name": "carsso/ovh-simple-voicemail-manager",
    "description": "Self-hosted PHP manager for OVHcloud telephony voicemails",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ovh/ovh": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
